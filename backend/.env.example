APP_NAME="Baxall Site Assistant API"
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

# Persistence backend: "sqlite" (file-based, default) or "memory"
PERSISTENCE_BACKEND=sqlite
# SQLite file location (relative paths resolve against the backend folder)
DATABASE_PATH=baxall.db

JWT_SECRET_KEY=baxall-local-prototype-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

MOCK_OCR_DELAY=1.6
MOCK_AI_DELAY=1.4

# Local speech-to-text (faster-whisper). tiny/base = fastest, small/medium =
# more accurate but slower on CPU. Weights are downloaded once on first use
# and cached under STT_MODEL_CACHE_DIR, then reused fully offline.
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
STT_MODEL_CACHE_DIR=.cache/whisper

CORS_ORIGINS=*
